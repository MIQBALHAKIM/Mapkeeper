{
  "name": "mapkeeper",
  "version": "3.0.0",
  "description": "Router for Graphify, spec-kit, and security-audit: detect providers, hand off, and link their native outputs without reimplementing them.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mapkeeper": "scripts/mapkeeper.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && node scripts/build-guide.mjs --check",
    "build:guide": "node scripts/build-guide.mjs",
    "status": "node scripts/mapkeeper.mjs status",
    "links": "node scripts/mapkeeper.mjs links",
    "map": "node scripts/mapkeeper.mjs"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "NOTICE",
    "index.html",
    "command/",
    "references/",
    "scripts/"
  ],
  "keywords": [
    "router",
    "graphify",
    "spec-kit",
    "security-audit",
    "project-map",
    "agent-skills",
    "codebase-analysis"
  ]
}