{
  "name": "mapkeeper",
  "version": "2.1.0",
  "description": "Living project map: validated knowledge graph, coverage ledger, Obsidian vault, and architecture exports, with Graphify, spec-kit, and security-audit adapters.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && node scripts/build-guide.mjs --check && node scripts/build-guide.mjs --prompt --check",
    "build:guide": "node scripts/build-guide.mjs",
    "build:prompt": "node scripts/build-guide.mjs --prompt",
    "map": "node scripts/mapkeeper.mjs",
    "doctor": "node scripts/mapkeeper.mjs doctor"
  },
  "files": [
    "SKILL.md",
    "Mapkeeper_Prompt.md",
    "README.md",
    "index.html",
    "command/",
    "references/",
    "schema/",
    "scripts/",
    "spec-kit-extension/"
  ],
  "keywords": [
    "skill",
    "project-map",
    "architecture",
    "knowledge-graph",
    "obsidian",
    "spec-kit",
    "graphify"
  ]
}