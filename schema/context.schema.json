{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapkeeper.dev/schema/context.schema.json",
  "title": "Mapkeeper LLM context note",
  "description": "Contract for the YAML frontmatter and body of project-map/obsidian-vault/02-LLM-Context.md. The validator parses flat scalar frontmatter only; nested values are not required here.",
  "type": "object",
  "required": ["project", "phase", "status", "source_revision", "generated_at", "budget_tokens"],
  "additionalProperties": true,
  "properties": {
    "project": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["BEFORE", "DURING", "END"] },
    "status": { "type": "string", "minLength": 1 },
    "source_revision": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 10 },
    "budget_tokens": { "type": "integer", "minimum": 100, "maximum": 2000 },
    "coverage": { "type": "object" },
    "open_risks": { "type": "integer", "minimum": 0 }
  }
}