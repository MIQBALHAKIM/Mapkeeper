{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mapkeeper.dev/schema/graph.schema.json",
  "title": "Mapkeeper graph",
  "type": "object",
  "required": ["schema_version", "meta", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "meta": {
      "type": "object",
      "required": ["project_name", "phase", "update_mode", "generated_at", "source_revision", "graphify", "counts"],
      "additionalProperties": true,
      "properties": {
        "project_name": { "type": "string" },
        "phase": { "enum": ["BEFORE", "DURING", "END"] },
        "update_mode": { "enum": ["INIT", "SYNC", "AUDIT", "FULL"] },
        "generated_at": { "type": "string", "minLength": 10 },
        "source_revision": { "type": "string", "minLength": 1 },
        "graphify": {
          "type": "object",
          "required": ["available"],
          "additionalProperties": true,
          "properties": {
            "available": { "type": "boolean" },
            "version": { "type": ["string", "null"] },
            "graph_path": { "type": ["string", "null"] }
          }
        },
        "counts": {
          "type": "object",
          "required": ["nodes", "edges"],
          "additionalProperties": true,
          "properties": {
            "nodes": { "type": "integer", "minimum": 0 },
            "edges": { "type": "integer", "minimum": 0 },
            "by_derivation": { "type": "object" }
          }
        },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "unknowns": { "type": "array", "items": { "type": "string" } }
      }
    },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "hyperedges": { "type": "array", "items": { "type": "object" } },
    "coverage": {
      "type": "object",
      "required": ["units_total", "mapped", "stale", "unmapped", "out_of_scope"],
      "additionalProperties": true,
      "properties": {
        "units_total": { "type": "integer", "minimum": 0 },
        "mapped": { "type": "integer", "minimum": 0 },
        "stale": { "type": "integer", "minimum": 0 },
        "unmapped": { "type": "integer", "minimum": 0 },
        "out_of_scope": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "kind", "label", "status", "derivation"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$" },
        "kind": {
          "enum": [
            "project", "goal", "requirement", "stakeholder", "user_role", "feature",
            "task", "milestone", "component", "module", "service", "file", "folder",
            "api", "database", "data_entity", "workflow", "decision", "risk", "issue",
            "assumption", "dependency", "deployment_target", "environment", "test",
            "document", "constraint", "deliverable", "finding", "trust_boundary", "control"
          ]
        },
        "label": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "status": {
          "enum": ["planned", "implemented", "unknown", "deprecated", "confirmed", "needs_validation"]
        },
        "phase": { "enum": ["BEFORE", "DURING", "END"] },
        "confidence": { "enum": ["low", "medium", "high"] },
        "derivation": { "enum": ["graphify", "speckit", "security", "llm", "merged"] },
        "provenance": { "type": "object" },
        "spec_refs": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "severity": { "enum": ["critical", "high", "medium", "low", "informational"] },
        "verdict": { "enum": ["confirmed", "needs_validation", "rejected"] },
        "last_verified": {
          "type": "object",
          "required": ["revision", "date"],
          "additionalProperties": true,
          "properties": {
            "revision": { "type": "string" },
            "date": { "type": "string" }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["source", "target", "relation", "confidence", "derivation"],
      "additionalProperties": true,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "relation": {
          "enum": [
            "calls", "implements", "references", "cites", "conceptually_related_to",
            "shares_data_with", "semantically_similar_to", "rationale_for", "depends_on",
            "produces", "consumes", "manages", "decides", "blocks", "supports", "documents",
            "tests", "deploys_to", "satisfies_requirement", "affects", "violates", "mitigated_by",
            "relates_to", "contains"
          ]
        },
        "confidence": { "enum": ["EXTRACTED", "INFERRED", "AMBIGUOUS"] },
        "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "derivation": { "enum": ["graphify", "speckit", "security", "llm", "merged"] },
        "summary": { "type": "string" },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "last_updated": { "type": "string" }
      }
    }
  }
}